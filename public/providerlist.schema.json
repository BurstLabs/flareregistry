{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flareregistry.com/providerlist.schema.json",
  "title": "Flare Registry FTSO Signal Provider List",
  "description": "The provider list published by Flare Registry at https://flareregistry.com/api/feed/providerlist.json and committed to BurstLabs/flareregistry as providerlist.json. The seven base fields of each entry are byte-compatible with the FTSO provider list the Bifrost/TowoLabs schema described, so a consumer written for that format reads this one unchanged and ignores the namespaced object. Draft-07 rather than a later draft because it is what validators in this ecosystem already support.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "name",
    "timestamp",
    "version",
    "providers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "This schema."
    },
    "name": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this document was generated."
    },
    "version": {
      "$ref": "#/definitions/Version"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProviderInfo"
      },
      "uniqueItems": true,
      "maxItems": 10000
    }
  },
  "definitions": {
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor",
        "patch"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ProviderInfo": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "chainId",
        "name",
        "description",
        "url",
        "address",
        "logoURI",
        "listed",
        "flareregistry"
      ],
      "properties": {
        "chainId": {
          "type": "integer",
          "enum": [
            14,
            19,
            114
          ],
          "description": "14 Flare, 19 Songbird, 114 Coston2."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "description": "The text published for THIS network. A provider on both chains may set different text for each."
        },
        "url": {
          "type": "string"
        },
        "address": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          ],
          "description": "Checksummed listing address, normally the delegation address."
        },
        "logoURI": {
          "type": "string",
          "format": "uri"
        },
        "listed": {
          "type": "boolean",
          "description": "Show in pickers and discovery. Equals flareregistry.status === \"listed\"."
        },
        "flareregistry": {
          "$ref": "#/definitions/Extras"
        }
      }
    },
    "Extras": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "verified",
        "registered",
        "managementGroup",
        "qualified",
        "network",
        "feePercent",
        "votePower",
        "votePowerCapped",
        "feedCount",
        "lastEpoch",
        "activeSince",
        "delegatorRewardLastEpoch",
        "feeRewardLastEpoch",
        "entity",
        "validators",
        "selfDeclared",
        "qualification",
        "logoHash",
        "status",
        "updatedAt",
        "attestedAt"
      ],
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "The owner proved control of this address by signature."
        },
        "registered": {
          "type": "boolean",
          "description": "Matched to a registered FTSO entity in Flare's on-chain reward data."
        },
        "managementGroup": {
          "type": "boolean"
        },
        "qualified": {
          "type": "boolean",
          "description": "Meets every automatable criterion; see /api."
        },
        "network": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "flare",
            "songbird",
            "coston2",
            null
          ]
        },
        "feePercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "votePower": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$",
          "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
        },
        "votePowerCapped": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$",
          "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
        },
        "feedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lastEpoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "activeSince": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "Month first seen on this network."
        },
        "delegatorRewardLastEpoch": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$",
          "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
        },
        "feeRewardLastEpoch": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$",
          "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
        },
        "logoHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the bytes at logoURI, lowercase hex, no 0x prefix. Null where we do not host the image."
        },
        "status": {
          "type": "string",
          "enum": [
            "listed",
            "held",
            "unqualified",
            "departed",
            "suspended",
            "unnamed",
            "dormant"
          ],
          "description": "Why this entry is or is not listed. listed: meets every criterion and is past its hold. held: qualified but inside the 30-day new-provider or new-claim window. unqualified: does not currently meet the criteria. departed: not qualified and silent for 26 reward epochs or more. suspended: a governance case closed against it. unnamed: registered on-chain with no published identity. dormant: holds a registration that has never taken part."
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When this entry's published name, description, url or logo last changed. Null on an entry carrying another list's text."
        },
        "attestedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When this address last proved control by signature. Null if never claimed."
        },
        "entity": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "identity",
            "submit",
            "submitSignatures",
            "signingPolicy",
            "delegation"
          ],
          "properties": {
            "identity": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "submit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "submitSignatures": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "signingPolicy": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "delegation": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "nodeId",
              "feePercent",
              "uptimePercent",
              "connected",
              "weight",
              "selfBond",
              "delegatedWeight",
              "delegatorCount"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^NodeID-"
              },
              "feePercent": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "uptimePercent": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "connected": {
                "type": "boolean"
              },
              "weight": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+$",
                "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
              },
              "selfBond": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+$",
                "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
              },
              "delegatedWeight": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]+$",
                "description": "Wei-scale integer as a decimal string; JSON numbers cannot hold it."
              },
              "delegatorCount": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "selfDeclared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "privateNode",
            "algorithm",
            "singleEntity"
          ],
          "properties": {
            "privateNode": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "algorithm": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "in-house",
                "open-source",
                null
              ]
            },
            "singleEntity": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "description": "Provider-attested, not verified on-chain."
        },
        "qualification": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "qualifiedSince",
            "lastSubmittedEpoch",
            "epochsSinceSubmit",
            "epochsUntilRevoke",
            "revokeAfterEpochs"
          ],
          "properties": {
            "qualifiedSince": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "lastSubmittedEpoch": {
              "type": [
                "integer",
                "null"
              ]
            },
            "epochsSinceSubmit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "epochsUntilRevoke": {
              "type": [
                "integer",
                "null"
              ]
            },
            "revokeAfterEpochs": {
              "type": "integer"
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "underReview",
            "suspended",
            "caseId",
            "state"
          ],
          "properties": {
            "underReview": {
              "type": "boolean"
            },
            "suspended": {
              "type": "boolean"
            },
            "caseId": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Present only when a case exists."
        }
      }
    }
  }
}
