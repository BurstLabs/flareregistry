// Flare Registry data model.
//
// A Provider is one organisation that runs a signal-provider operation. It owns one or more
// ProviderAddress rows (one per chain it operates on) and exactly one piece of branding
// (name, description, url, logo). Ownership is anchored to the on-chain address: a row only
// becomes verified after the wallet for that address signs a challenge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id          String  @id @default(cuid())
  // Branding shown in the feed and directory.
  name        String
  description String
  url         String
  // Stored relative for self-hosted logos; the feed expands it to an absolute logoURI.
  logoPath    String?
  // For imported providers we keep the source's absolute logo URL verbatim until the owner
  // claims the entry and uploads their own. Null for natively-submitted providers.
  logoURI     String?
  // Provenance. "submitted" = created through the sign-in flow on this site. "imported" =
  // seeded from an external list and not yet owner-claimed.
  source      String  @default("submitted")

  // Self-declared fields: things the TowoLabs extended requirements list but that cannot be
  // verified on-chain, so they are provider-attested and shown labeled as "self-declared".
  // privateNode: submits prices from a private (not shared) node.
  privateNode  Boolean? // null = not declared
  // algorithm: "in-house" | "open-source" | null (not declared).
  algorithm    String?
  // singleEntity: operator attests they run one registered entity per network (no entity-splitting).
  singleEntity Boolean? // null = not declared

  // Governance (new-provider flag mechanism, see docs/governance-flag-mechanism.md).
  // flaggedOnce: this account has already been through the flag process once (once-only guard).
  flaggedOnce Boolean @default(false)
  // suspended: a DENIED flag outcome. Not Qualified, hidden from the default directory.
  suspended   Boolean @default(false)

  // ARCHIVE (soft-delete) instead of hard-deleting a departed provider. The purge job sets this when
  // a provider is unqualified and has not submitted prices for the purge window on every matched
  // network; archived providers are EXCLUDED from the live feed but kept for the audit record (served
  // read-only at /api/feed/archived.json) and auto-unarchived if they become active again. Null = live.
  archivedAt     DateTime?
  archivedReason String?

  // PENDING LOGO: a newly uploaded logo is held for a review window (LOGO_REVIEW_DAYS, default 7)
  // before it goes live, so an inappropriate image is not published instantly. The pending PNG lives
  // at assets/pending/<addr>.png; the live logoURI is untouched until a cron promotes it. Cleared on
  // promotion (or admin rejection). logoPendingAt is when the upload happened.
  logoPendingURI    String?
  logoPendingAt     DateTime?
  logoPendingSigner String? // lowercased address that uploaded it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   ProviderAddress[]
  flagCases   ProviderFlagCase[]
  logoReports LogoReport[]
  watches     ProviderWatch[]

  @@index([archivedAt])
  @@index([logoPendingAt])
}

// A self-service, per-provider email watch. Anyone (no wallet) can ask to be emailed if a NEW
// provider is flagged, while it is still in its review window. Privacy by design: these rows exist
// ONLY while the provider is under review. When the provider lists/qualifies (or is denied and thus
// permanently off the feed), every watch for it is DELETED (the email is shredded), so we never
// retain a subscriber's address once there is nothing left to notify them about.
//
// Double opt-in: a watch is created unconfirmed with a random token; a confirmation link flips
// `confirmed` true. Only confirmed watches are emailed, so nobody can subscribe a stranger's inbox.
model ProviderWatch {
  id          String    @id @default(cuid())
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // Lowercased email address. Unique per provider so a re-subscribe updates rather than duplicates.
  email       String
  // Double opt-in: false until the confirmation link is followed. Only confirmed watches are sent.
  confirmed   Boolean   @default(false)
  // Random URL-safe token for the confirm (and one-click unsubscribe) link. Single value reused for both.
  token       String    @unique
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([providerId, email])
  @@index([providerId])
}

// Append-only record of a logo being reported as inappropriate by a Management Group member. History
// is RETAINED: admin actions update status/resolvedAt/resolvedBy, rows are never deleted, so who
// reported what (and when, and how it was resolved) is permanently on record.
model LogoReport {
  id         String   @id @default(cuid())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  // The logo URL that was reported (so the record stands even after the logo is later changed).
  logoURI         String?
  reporterAddress String // lowercased MG-member address that signed the report
  reporterVoter   String // canonical member-entity voter for that address
  reason          String

  // OPEN -> resolved by an admin. Rows are never deleted (history kept).
  status     String    @default("OPEN") // OPEN | LOGO_REMOVED | DISMISSED
  resolvedAt DateTime?
  resolvedBy String? // lowercased admin address

  createdAt DateTime @default(now())

  @@index([providerId])
  @@index([status])
}

// One on-chain address the provider operates, on one chain. This is the unit that gets
// verified and the unit that becomes a feed entry.
model ProviderAddress {
  id         String   @id @default(cuid())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  // EVM chain id (14 Flare, 19 Songbird).
  chainId Int
  // Lowercased 0x address. Unique per chain so two providers can't both claim it.
  address String

  // True only after a valid signature from this address is recorded, i.e. the owner has
  // claimed the entry. Imported entries start false even though they appear in the feed.
  verified   Boolean   @default(false)
  verifiedAt DateTime?

  // The feed's "listed" flag for this entry. For imported entries this carries the source
  // list's listed value verbatim. For owner-submitted entries it is true once verified.
  listed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, address])
  @@index([providerId])
}

// PERMISSIONLESS TELEGRAM ACCESS for signal providers.
//
// A provider proves control of any of its five on-chain role addresses by signature, and the bot lets
// it into the group. Nobody approves anyone: the chain decides and the bot executes.
//
// Why a per-entity invite link rather than a one-time link. A link with member_limit 1 guarantees that
// SOMEONE gets in, not that the RIGHT someone does, and a forwarded URL inside the expiry window is a
// real hole. Instead each entity gets its own link created with creates_join_request true. Telegram's
// chat_join_request update carries the invite_link that was used, so the bot can match the joining
// account back to the entity that earned the link and approve only that one. A leaked link produces a
// request the bot declines, because approval is keyed to the token rather than to holding the URL.
//
// Keyed on `voter` alone, not (network, voter): a voter address belongs to one operator, so this is
// the natural sybil unit, and an operator running on both chains should get one seat rather than two.
model TelegramAccess {
  id String @id @default(cuid())

  // Identity (voter) address of the entity that earned access. Lowercased.
  voter   String @unique
  // Network the entity qualified on at issue time. Informational: eligibility is rechecked across
  // both chains, so qualifying on either keeps access.
  network String

  // Random URL-safe token, carried in the invite link's `name` so the webhook can match a join
  // request back to this row without trusting anything the joining user sends.
  token      String  @unique
  // The invite link Telegram returned. Compared against ChatJoinRequest.invite_link.invite_link.
  inviteLink String?

  // issued -> joined, or -> declined. `removed` is set by the revocation job.
  state String @default("issued")

  // Telegram identity, recorded only once they actually join. The user id is what banChatMember
  // needs; the username is kept purely so a human admin can tell who is who in the member list.
  telegramUserId   String?
  telegramUsername String?

  issuedAt DateTime  @default(now())
  joinedAt DateTime?

  // REVOCATION. Set when a sweep first finds the entity no longer eligible, cleared the moment it
  // qualifies again. Once it has stood for TELEGRAM_REVOKE_AFTER_DAYS the bot removes the member.
  // Stored as a timestamp rather than a countdown so a restarted or missed cron cannot reset the
  // clock in the member's favour or against them.
  ineligibleSince DateTime?
  removedAt       DateTime?

  @@index([state])
  @@index([ineligibleSince])
}

// SUCCESS-RATE HISTORY.
//
// Flare's systems explorer serves success rates as a LIVE GAUGE, not a series: the object carries no
// epoch, there is no historical endpoint, and every poll overwrites the last. So unlike passes.json,
// which sits in git and can be replayed for any epoch, the past here is unrecoverable. The only way
// to ever have a series is to start keeping one.
//
// That matters because success rates are the largest continuous input to the reputation figure. Until
// this table has depth, a provider whose accuracy score moves cannot be shown why, and last month's
// number cannot be reconstructed if it is disputed. That is the opacity criticism this registry was
// built to replace, so it should not be left standing in our own scoring.
//
// A SEPARATE TABLE, deliberately not extra columns on ProviderMetricEpoch. That table is keyed per
// reward epoch and is also what the longevity component counts; writing success snapshots into it
// would create rows for epochs whose reward data has not published yet, and every such row would
// silently add a point of tenure to the provider it belongs to.
model ProviderSuccessSnapshot {
  id      String @id @default(cuid())
  network String
  voter   String
  // The reward epoch the explorer attributed the reading to. Unique per entity so repeated polls
  // within one epoch update rather than pile up.
  epochId Int

  primary      Int?
  secondary    Int?
  availability Int?

  takenAt DateTime @default(now())

  @@unique([network, voter, epochId])
  @@index([network, epochId])
}

// One-time signing challenges. A nonce is issued for an address, consumed on successful
// verification, and expires shortly after issue so a leaked nonce is not reusable.
model AuthChallenge {
  id        String   @id @default(cuid())
  address   String // lowercased claimed address
  nonce     String   @unique
  chainId   Int? // chain the challenge was issued for; pinned at verify time (S5/S6)
  action    String? // optional bound action (e.g. "vote", "flag"); checked at verify time (S5)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([address])
}

// On-chain identity of a registered FTSO entity, ingested from the Flare-published
// fsp-rewards reward-epoch-info.json. One row per (identity voter address, network), updated
// to the latest epoch seen. Used to (a) match a Flare Registry listing to its on-chain entity by
// any of the entity's addresses, and (b) drive the "Registered" badge.
//
// Amounts/weights are wei-scale and stored as decimal strings; do bigint math in code.
model ProviderOnchain {
  id      String @id @default(cuid())
  // "flare" or "songbird".
  network String
  // Lowercased identity (voter) address — the entity's canonical key.
  voter   String

  delegationAddress       String?
  submitAddress           String?
  submitSignaturesAddress String?
  signingPolicyAddress    String?
  // Validator node ids the entity manages (JSON array of strings).
  nodeIds                 Json?

  // Current (latest-epoch) snapshot fields for quick display without scanning history.
  feeBips          Int?
  wNatWeight       String?
  wNatCappedWeight String?
  signingWeight    String?
  feedCount        Int?
  registered       Boolean @default(true)

  // OFFICIAL success rates, from Flare's own systems-explorer entity API (providersuccessrate).
  // Stored verbatim in BASIS POINTS out of 10000, exactly as Flare publishes them, so the stored value
  // is never a lossy re-derivation of someone else's metric. Divide by 100 for a percentage.
  //   successPrimary      primary reward band participation
  //   successSecondary    secondary reward band participation
  //   successAvailability uptime/availability
  // Observed on Flare: primary median ~4993 with a 0-8017 spread, secondary median ~9515.
  successPrimary      Int?
  successSecondary    Int?
  successAvailability Int?
  // Reward epoch the rates describe, and when we last refreshed them.
  successEpoch        Int?
  successUpdatedAt    DateTime?

  // CURRENT-epoch weights from the same systems-explorer entity record, wei-scale strings.
  // delegationWeight is what Flare's own explorer labels "DELEGATION WEIGHT", so the registry shows the
  // same figure an operator sees on Flare's site. It is NOT the same as wNatWeight above: that comes
  // from the fsp-rewards ingest, which lags by reward epochs (measured: 1FTSO 20.8M there vs 40.7M
  // current, Burst FTSO 146.0M vs 123.2M). Different source, different freshness, kept separate on
  // purpose rather than one silently overwriting the other.
  delegationWeight       String?
  delegationWeightCapped String?
  stakingWeight          String?

  // FIP.16 REGISTRATION WEIGHT, read verbatim from the chain rather than recomputed.
  //   VoterRegistry.getVoterRegistrationWeight(voter, rewardEpochId)
  //   0xA480457953Af3583E54DCd630b219353B8FC9Af7 (Flare mainnet)
  // This is what actually determines a provider's influence in the protocol, unlike delegation weight,
  // which ignores stake entirely and is linear where FIP.16 is concave. The underlying computation is
  //   S = 5*sum(mirrored P-chain stake over nodeIds) + min(2.5% of total WNat, WNat of delegationAddress)
  //   weight = isqrt(S) * isqrt(isqrt(S))       an integer floor of S^0.75
  // We store the CONTRACT'S answer rather than our own arithmetic, so the figure cannot drift from the
  // protocol and any provider can check it with a single eth_call. Wei-scale string; the unit is
  // wei^0.75, so divide by 10^13.5 for FLR^0.75.
  registrationWeight String?
  registrationEpoch  Int?
  // Latest known minimal-conditions verdict, carried from the newest ingested epoch. Nullable for the
  // same reason as on ProviderMetricEpoch: "we have not been told" must not render as "passed".
  goodStanding       Boolean?

  // MANAGEMENT GROUP ELIGIBILITY, from scripts/ingest-mg-eligibility.mjs. Flare only.
  // mgEligible and mgVerdict come from simulating PollingManagementGroup.addMember() with eth_call, so
  // they are the contract's own answer rather than ours. The streak/remaining pair is our transcription
  // of the contract's walk-back and exists only to turn "no" into "how far off". Where the two
  // disagree the simulation wins; the script logs the disagreement rather than papering over it.
  mgEligible            Boolean?
  mgVerdict             String? // verbatim revert string, or "SUCCESS"
  mgBlockReason         String? // rewards | chilled | recently-removed | delegation-address
  mgRewardedStreak      Int? // consecutive initialised epochs with rewards
  // addAfterRewardedEpochs as it stood when this row was checked. Governance can change it, and the
  // page says "5 of N", so the N is recorded per check rather than hardcoded in the UI where a
  // governance vote would silently make it a lie.
  mgRequiredEpochs      Int?
  mgEpochsRemaining     Int? // null when no honest countdown exists (member, or no delegation address)
  mgBlockedAtEpoch      Int? // the epoch that broke the streak, so a provider can go look at it
  // The recently-removed gate is a 7-day timer, not an epoch count. Such a provider usually still
  // holds a full reward streak, so the epoch countdown is 0 and would render as "eligible now" while
  // the contract keeps refusing. When the block is time-based the answer is a date.
  mgBlockedUntil        DateTime?
  // Wall-clock dates, so a provider does not have to know that a reward epoch is 3.5 days to work out
  // what a 20-epoch countdown means. Both are derived from the chain's own timing getters
  // (currentRewardEpochExpectedEndTs, getRewardEpochStartInfo) rather than arithmetic on a hardcoded
  // genesis timestamp.
  //
  // mgEligibleEstimatedAt is an ESTIMATE and the copy says so: it assumes the provider is rewarded in
  // every intervening epoch, and epochs end when the next signing policy is set rather than strictly
  // on the timer, so the real date can drift later.
  mgEligibleEstimatedAt DateTime?
  mgBlockedAtEpochTs    DateTime?

  // REMOVAL STANDING, for sitting members. removeMember() is permissionless the same way addMember()
  // is, so a member can be one stranger's transaction away from losing their seat. mgRemovable is the
  // contract's own answer, from simulating that call; the rest explains it and shows how close a
  // member who is currently safe actually is.
  mgRemovable         Boolean?
  mgRemoveVerdict     String? // verbatim revert string, or "REMOVABLE"
  mgRemoveReason      String? // chilled | no-rewards | non-participation
  mgMissedVotes       Int? // decided proposals in the window this member did not vote in
  mgRelevantProposals Int? // size of that window (quorum-met, decided proposals since they joined)
  mgMissedVotesLimit  Int? // removeAfterNonParticipatingProposals, at which removal becomes possible
  mgEpochsSinceReward Int? // consecutive initialised epochs with no reward, counting back from now
  mgMemberSinceEpoch  Int?
  mgCheckedEpoch      Int?
  mgCheckedAt         DateTime?
  // Member of Flare's on-chain FTSO Management Group (PollingManagementGroup contract): the
  // curated set of eligible, well-performing providers. Refreshed from a live RPC query.
  managementGroup     Boolean   @default(false)

  lastEpochSeen Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([network, voter])
  @@index([delegationAddress])
  @@index([submitAddress])
  @@index([submitSignaturesAddress])
  @@index([signingPolicyAddress])
}

// A validator (P-chain node) and its current stats, from platform.getCurrentValidators. One row per
// (network, nodeId). Joined to providers by nodeId (which appears in ProviderOnchain.nodeIds).
model ProviderValidator {
  id      String @id @default(cuid())
  network String // "flare" | "songbird"
  nodeId  String // "NodeID-..."

  // Validator staking fee, percent (e.g. 10.0). Distinct from the FTSO delegationFeeBIPS.
  feePercent      Float?
  uptimePercent   Float?
  connected       Boolean   @default(false)
  // TOTAL stake on the node: self-bond PLUS delegated, as a decimal string in the P-chain's own unit
  // (1e9). This matches what the public API has always documented. It previously stored the P-chain's
  // `weight` field verbatim, which is SELF-BOND ONLY and understated the real figure by ~9.6x across
  // the Flare validator set. Both legs are kept separately so nothing is lost and consumers can split
  // them; `weight` stays the total because that is the published contract.
  weight          String?
  selfBond        String?
  delegatedWeight String?
  delegatorCount  Int?
  startTime       DateTime?
  endTime         DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([network, nodeId])
  @@index([nodeId])
}

// Per-provider, per-reward-epoch metrics ingested from fsp-rewards. One row per
// (network, epochId, voter). Powers history, charts, and per-epoch liveness.
model ProviderMetricEpoch {
  id      String @id @default(cuid())
  network String
  epochId Int
  // Lowercased identity (voter) address.
  voter   String

  feeBips          Int?
  wNatWeight       String?
  wNatCappedWeight String?
  signingWeight    String?
  feedCount        Int?
  // The signing-policy threshold for this epoch (same for all providers in the epoch); a
  // provider "participates" when its signing weight meets/exceeds a meaningful share. Stored
  // per row for simplicity. Decimal string.
  epochThreshold   String?

  // Reward amounts attributed to this entity this epoch (wei-scale decimal strings).
  feeReward       String? // claimType 1 (provider commission)
  delegatorReward String? // claimType 2 (WNAT pool to the delegation address)
  stakerReward    String? // claimType 3 (mirror/staking)

  // Was the entity registered/active this epoch, and in good standing (no applied penalties).
  registered   Boolean  @default(true)
  // MINIMAL CONDITIONS, from passes.json in the same epoch folder we already walk.
  //
  // goodStanding is eligibleForReward, verbatim. It used to be hardcoded true, which meant the
  // registry reported every provider as in good standing during epochs where Flare had burned all of
  // their rewards: 12 of 98 in epoch 420 alone. Null means the file was absent for that epoch, which
  // is not the same as passing, and must not be rendered as a tick.
  goodStanding Boolean?
  // Pass balance (0..3). A provider on 0 loses everything on the next failure, so the balance is the
  // early warning the eligibility flag alone cannot give.
  passes       Int?
  // Failure ids for the epoch, e.g. ["FDC_FAILURE"]. Flare attributes the cause directly, so this is
  // recorded rather than inferred. Empty list means no failures recorded; goodStanding carries the
  // "we were not told" signal, so this does not need to be nullable as well.
  failures     String[]

  createdAt DateTime @default(now())

  @@unique([network, epochId, voter])
  @@index([network, voter])
  @@index([network, epochId])
}

// Tracks the highest reward epoch ingested per network, so the job only fetches new epochs.
model IngestState {
  network           String   @id
  lastEpochIngested Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// Cached result of the address-on-website qualification check, keyed by provider url.
model WebsiteCheck {
  url       String   @id
  found     Boolean
  checkedAt DateTime @default(now())
}

// Persisted, LATCHING qualification state per on-chain entity. Qualification is sticky: once an
// entity becomes qualified it stays qualified, and the ONLY thing that revokes it is not
// submitting prices for ~9 consecutive reward epochs (30 days). After revocation it must
// re-qualify from scratch (full criteria, including the website-required onboarding window).
model QualificationState {
  id      String @id @default(cuid())
  network String
  voter   String // lowercased identity address

  qualified          Boolean   @default(false)
  // When the latch first turned on (also the restart point after a revocation).
  qualifiedAt        DateTime?
  // The most recent epoch in which this entity submitted/was present. Drives the no-submit gap.
  lastSubmittedEpoch Int?
  // The epoch at which qualification was last evaluated, so we only move forward.
  lastEvaluatedEpoch Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([network, voter])
}

// Governance: a flag case against a new provider, decided by the Management Group.
// See docs/governance-flag-mechanism.md for the full mechanism.
model ProviderFlagCase {
  id         String   @id @default(cuid())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  network    String

  // OPEN_DISCUSSION | OPEN_VOTING | DENIED | CLEARED | FAILED_QUORUM
  state            String
  openedAt         DateTime  @default(now())
  discussionEndsAt DateTime
  votingEndsAt     DateTime
  decidedAt        DateTime?

  // True when this case is the one permitted appeal of a prior DENIED case.
  isReVote          Boolean @default(false)
  // Member count snapshot at open, for display. Live count is used at tally.
  memberCountAtOpen Int
  // Recorded at tally for the public record.
  outcomeTurnout    Int?
  outcomeDeny       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiations   ProviderFlagInitiation[]
  votes         ProviderFlagVote[]
  voteRevisions ProviderFlagVoteRevision[]
  pointImages   ProviderFlagPointImage[]
  defense       ProviderFlagDefense?
}

// A Management Group member co-initiating a flag. Two distinct members open a case.
model ProviderFlagInitiation {
  id                String           @id @default(cuid())
  case              ProviderFlagCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId            String
  // The member entity's identity (voter) address; one initiation per member entity per case.
  memberEntityVoter String
  signerAddress     String
  // Optional one-line subject for this point (falls back to "Point N" in the UI when null).
  title             String?
  // The CURRENT grounds text. The member can edit this while the case is still pre-vote; every
  // version (including the first) is preserved as a ProviderFlagGroundsRevision for the record.
  grounds           String
  createdAt         DateTime         @default(now())
  // Set when the grounds were last edited (null = never edited, still the original text).
  editedAt          DateTime?
  // Set when this co-initiator withdrew their flag (the case is then archived WITHDRAWN). The
  // initiation is kept for the public record rather than deleted.
  withdrawnAt       DateTime?

  revisions ProviderFlagGroundsRevision[]
  // Supplemental grounds the same member adds later (extra evidence/notes). Informational only:
  // they do NOT count as additional co-initiations; the primary `grounds` above is the one flag.
  entries   ProviderFlagGroundsEntry[]

  @@unique([caseId, memberEntityVoter])
}

// Append-only history of a flag's grounds. One row per version (the first is the original text);
// the member edits freely while the case is pre-vote, but no version is ever altered or removed,
// so the public record shows exactly what changed and when.
model ProviderFlagGroundsRevision {
  id            String                 @id @default(cuid())
  initiation    ProviderFlagInitiation @relation(fields: [initiationId], references: [id], onDelete: Cascade)
  initiationId  String
  // The grounds + title as of this version (title null = no subject at that time).
  grounds       String
  title         String?
  // The address that signed this revision (the member's wallet at edit time).
  signerAddress String
  createdAt     DateTime               @default(now())

  @@index([initiationId])
}

// A supplemental grounds entry the flagging member adds after their first (e.g. new evidence). Each
// is independently editable with its own append-only revision history. Informational only: it does
// not affect co-initiation, quorum, or voting. Editable while the case is pre-vote.
model ProviderFlagGroundsEntry {
  id            String                 @id @default(cuid())
  initiation    ProviderFlagInitiation @relation(fields: [initiationId], references: [id], onDelete: Cascade)
  initiationId  String
  // Optional one-line subject (falls back to "Point N" in the UI when null).
  title         String?
  grounds       String
  signerAddress String
  createdAt     DateTime               @default(now())
  // Set when this entry was last edited (null = never edited).
  editedAt      DateTime?
  // If this entry is a REPLY to another point, the target's "<ownerType>:<ownerId>" ref (ownerType =
  // initiation|groundsEntry|defense|defenseEntry). Null = a top-level point. Lets the discussion
  // thread as a conversation across member and provider points.
  replyToRef    String?

  revisions ProviderFlagGroundsEntryRevision[]

  @@index([initiationId])
  @@index([replyToRef])
}

// Append-only version history for a supplemental grounds entry (mirrors ProviderFlagGroundsRevision
// for the primary grounds). The first row is the entry's original text.
model ProviderFlagGroundsEntryRevision {
  id            String                   @id @default(cuid())
  entry         ProviderFlagGroundsEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId       String
  grounds       String
  title         String?
  signerAddress String
  createdAt     DateTime                 @default(now())

  @@index([entryId])
}

// A Management Group member's vote on a case. One vote per member entity per case.
model ProviderFlagVote {
  id                String           @id @default(cuid())
  case              ProviderFlagCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId            String
  memberEntityVoter String
  signerAddress     String
  // "DENY" | "KEEP"
  vote              String
  comment           String?
  createdAt         DateTime         @default(now())
  // Bumped whenever the member changes their vote; equals createdAt for a vote never changed.
  updatedAt         DateTime         @default(now()) @updatedAt

  @@unique([caseId, memberEntityVoter])
}

// Append-only audit trail of every vote a member cast on a case, including changes. The current
// vote lives on ProviderFlagVote (one row per member); this keeps the FULL public history so a
// changed vote is transparent. One row per cast/change. Mirrors the grounds/defense revision pattern.
model ProviderFlagVoteRevision {
  id                String           @id @default(cuid())
  case              ProviderFlagCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId            String
  memberEntityVoter String
  signerAddress     String
  // "DENY" | "KEEP"
  vote              String
  comment           String?
  createdAt         DateTime         @default(now())

  @@index([caseId, memberEntityVoter])
}

// The flagged provider's public defense statement, editable during the 14-day window.
// The flagged provider's public response. The primary `body` is the first response; the provider
// can edit it (history kept) and add supplemental responses, mirroring the members' grounds.
model ProviderFlagDefense {
  id        String           @id @default(cuid())
  case      ProviderFlagCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String           @unique
  // Optional one-line subject (falls back to "Point N" in the UI when null).
  title     String?
  body      String
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())
  // Set when the body was last edited (null = never edited since first posted).
  editedAt  DateTime?

  revisions ProviderFlagDefenseRevision[]
  entries   ProviderFlagDefenseEntry[]
}

// Append-only version history of the primary defense body (first row is the original text).
model ProviderFlagDefenseRevision {
  id        String              @id @default(cuid())
  defense   ProviderFlagDefense @relation(fields: [defenseId], references: [id], onDelete: Cascade)
  defenseId String
  body      String
  title     String?
  createdAt DateTime            @default(now())

  @@index([defenseId])
}

// A supplemental response the provider adds after their first, each independently editable with its
// own history. Mirrors ProviderFlagGroundsEntry for the members' side.
model ProviderFlagDefenseEntry {
  id         String              @id @default(cuid())
  defense    ProviderFlagDefense @relation(fields: [defenseId], references: [id], onDelete: Cascade)
  defenseId  String
  // Optional one-line subject (falls back to "Point N" in the UI when null).
  title      String?
  body       String
  createdAt  DateTime            @default(now())
  editedAt   DateTime?
  // Reply target "<ownerType>:<ownerId>", or null for a top-level response. See ProviderFlagGroundsEntry.
  replyToRef String?

  revisions ProviderFlagDefenseEntryRevision[]

  @@index([defenseId])
  @@index([replyToRef])
}

// Append-only version history for a supplemental defense entry.
model ProviderFlagDefenseEntryRevision {
  id        String                   @id @default(cuid())
  entry     ProviderFlagDefenseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  body      String
  title     String?
  createdAt DateTime                 @default(now())

  @@index([entryId])
}

// An evidence image attached to a single governance "point" (a member's grounds or the provider's
// response). Exactly one owner column is set, identifying which point it belongs to. Files live on
// local disk under uploads/governance/<caseId>/<id>.<ext>, served via /api/governance/image/<id>.
// Images are re-encoded on upload to strip EXIF/metadata. caseId is denormalized for fast lookup and
// path building, and cascades on case delete.
model ProviderFlagPointImage {
  id     String           @id @default(cuid())
  case   ProviderFlagCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  // Polymorphic owner: exactly one of these is non-null.
  initiationId   String? // primary grounds of a member's initiation
  groundsEntryId String? // a supplemental grounds entry
  defenseId      String? // primary provider response
  defenseEntryId String? // a supplemental provider response entry

  // Stored file facts. mime is the RE-ENCODED type we wrote (image/png|jpeg|webp).
  mime          String
  ext           String
  width         Int
  height        Int
  bytes         Int
  signerAddress String
  createdAt     DateTime  @default(now())
  // When the author removed the image. The file bytes are discarded on removal, but the row stays so
  // the public record shows an image was attached then removed (and when). Null = still attached.
  removedAt     DateTime?

  @@index([caseId])
  @@index([initiationId])
  @@index([groundsEntryId])
  @@index([defenseId])
  @@index([defenseEntryId])
}

// Lightweight first-party traffic counter for the admin statistics. One row per (day, path), with a
// hit count and an approximate unique-visitor count. No cookies, no IPs stored: uniqueness is a
// best-effort daily salted hash kept only as a count, so this holds no personal data. Populated by
// POST /api/track from the client on navigation; read by the admin stats endpoint.
model PageView {
  id        String   @id @default(cuid())
  day       String // YYYY-MM-DD (UTC)
  path      String // normalized pathname, e.g. "/", "/provider/[address]"
  hits      Int      @default(0)
  uniques   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, path])
  @@index([day])
}

// A Consumer is a third-party product (wallet, block explorer, dApp, analytics site, tooling) that
// USES the Flare Registry feed, showcased on the public /powered-by page. Unlike a Provider it has no
// on-chain identity, so there is no wallet signature: submissions are moderated. Anyone may propose a
// NEW listing or an EDIT to an existing one; nothing goes live until an admin approves it (the admin
// queue is the single trust gate). Edits do not touch the live fields - the proposed values sit in
// pendingChanges until approval, so the current listing keeps showing meanwhile.
model Consumer {
  id           String  @id @default(cuid())
  name         String
  url          String
  // One of: wallet | explorer | dapp | analytics | tooling | other. Free-typed but validated server-side.
  category     String
  // Short blurb: how they use the feed. Shown on the showcase card.
  blurb        String
  // Optional https logo URL (external, provider-hosted). No git-CDN upload pipeline for consumers in v1.
  logoURL      String?
  // Private, admin-only contact for follow-up. Never emitted to the public showcase.
  contactEmail String?

  // Moderation state. approved rows are the only ones shown publicly.
  status String @default("pending") // pending | approved | rejected

  // For an EDIT proposal against an approved row: the submitted values awaiting review, stored WITHOUT
  // overwriting the live fields. On approve they merge into the row and this clears. Null when there is
  // no proposal in flight (a plain approved listing, or a brand-new pending listing).
  pendingChanges Json?
  // "new" | "edit": drives the admin queue label. A brand-new pending row is "new"; a proposed change
  // to an already-approved row is "edit".
  pendingKind    String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([status])
}

// An ImportCandidate is a provider entry that exists on an EXTERNAL legacy list (the TowoLabs
// ftso-signal-providers list, which wallets historically consumed) but is NOT yet in our registry.
// A scan fetches that list, diffs it against our ProviderAddress set, and records new-to-us entries
// here as `pending`. An admin reviews the queue and either APPROVES (creates an unclaimed
// source="imported" Provider, which then follows the normal path: it appears in the feed only once it
// qualifies on-chain or the real owner claims it by signature) or DISMISSES (kept as a tombstone so
// the same entry is not re-surfaced every scan). Candidates whose address later appears in our DB by
// any means are auto-resolved to `absorbed`.
model ImportCandidate {
  id      String @id @default(cuid())
  // Source list identifier, for when we add more upstreams later. "towolabs" for now.
  source  String @default("towolabs")
  chainId Int
  // Lowercased 0x address (the dedupe key against ProviderAddress).
  address String

  // Snapshot of the upstream entry at first sight (and refreshed each scan while still pending).
  name        String
  description String
  url         String
  logoURI     String?

  // pending  = awaiting admin review
  // approved = admin accepted; an imported Provider was created
  // dismissed = admin declined; kept so we don't re-surface it
  // absorbed = the address now exists in our registry by other means (owner claimed, native submit)
  status String @default("pending")

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@unique([chainId, address])
  @@index([status])
}

// A per-round snapshot of OUR reference example-provider instances' values (Flare only). We run N
// independent instances of flare-foundation/ftso-v2-example-value-provider; each round we record each
// instance's value per feed. Kept only for a short window (the scorer consumes them, then they are
// pruned) - this is not long-term storage. `values` is a JSON map feedName -> number, `instance` is
// the reference instance id (e.g. "ref1"/"ref2"). Two instances let us measure the example provider's
// own non-determinism floor, which calibrates the similarity score.
model ReferenceSample {
  id        String   @id @default(cuid())
  round     Int
  instance  String
  values    Json // { "BTC/USD": 64601.57, ... }
  createdAt DateTime @default(now())

  @@unique([round, instance])
  @@index([round])
  @@index([createdAt])
}

// Rolling per-provider similarity accumulators (Flare only). NOT raw values: each round we score every
// provider's LONG-TAIL feed submissions against our reference instances and against the field, then
// fold the result into these exponentially-weighted accumulators. `probability` is the calibrated
// output (0..1) that a provider runs the unmodified example provider; `confidence` scales with
// roundsObserved. See docs and import-scan sibling for the scoring method.
model ProviderSimilarity {
  id      String @id @default(cuid())
  network String @default("flare")
  voter   String // provider identity (lowercased)

  // EW-mean of the standardized "tracks our reference more tightly than the field" signal, over the
  // long-tail feeds. Higher = more example-provider-like.
  refSimilarityMean  Float @default(0)
  // EW-variance of the same, for confidence/consistency.
  refSimilarityVar   Float @default(0)
  // EW-mean deviation from the field consensus median (a reusable ACCURACY signal, independent of the
  // example-provider question).
  fieldDeviationMean Float @default(0)

  roundsObserved      Int     @default(0)
  probability         Float   @default(0)
  confidence          Float   @default(0)
  // Which reference VARIANT (full|top5|top10) this provider best matches - reveals their likely
  // exchange config when they run the example code.
  bestVariant         String?
  // CO-EXCURSION signal: when our reference example provider deviates sharply from the network median on
  // a feed (a shared-source "spike"), does THIS provider deviate the same way at the same round? EW rate
  // of same-direction co-excursion with the reference (0..1), the count of joint opportunities, and the
  // combined probability that folds value-similarity AND co-excursion together.
  coExcursionRate     Float   @default(0)
  coExcursionN        Int     @default(0)
  combinedProbability Float   @default(0)
  // ERROR PROFILE: EW mean of ln(|deviation from field median|) PER FEED, as {feedName: number}. The
  // shape of this vector - which feeds a provider is unusually good or bad on - is determined by its
  // exchange set and aggregation, so it fingerprints the implementation. Compared against the reference's
  // profile AFTER subtracting each feed's difficulty baseline (illiquid feeds are hard for everyone, and
  // that common component otherwise dominates and even ranks verified-custom providers highly).
  feedErrorsJson      Json?
  errorProfileN       Int     @default(0)

  // TICK-GRID (value lattice) evidence. The example provider's weightedMedian() returns an OBSERVED TRADE
  // PRINT verbatim, so its value sits on some venue's tick grid. When a venue's tick is coarser than the
  // on-chain encoding grid (T = tick * 10^decimals >= 2), "enc is divisible by T" is a real constraint
  // with an EXACT null of 1/T. These are CUMULATIVE (not EW) sums, because the null is exact and
  // stationary, so power grows without bound as rounds accumulate:
  //   lift = latticeHits / latticeExpected     (1.0 = pure chance, our reference measures 3.3x-5.9x)
  //   z    = (latticeHits - latticeExpected) / sqrt(latticeVar)
  // Needs NO reference instance and is unaffected by how ACCURATE our reference is.
  latticeHits     Float @default(0)
  latticeExpected Float @default(0)
  latticeVar      Float @default(0)
  latticeTrials   Int   @default(0)

  // PER-CELL hit profile: {"BTC/USD|10": summedExcess, ...}, keyed by feed name + lattice T (NOT feed
  // index, which shifts whenever a feed is listed). Aggregate lift cannot rank the non-excluded
  // providers, because it is confounded by config size (our own configs span 1.44x-2.33x) and because
  // any median-of-prints implementation reads high. WHICH cells a provider over-hits is set by its VENUE
  // LIST, so correlating this profile against our reference instances' profiles asks the sharper
  // question: does it over-hit the same cells a real example provider does?
  // Validated: ref-vs-ref r = 0.624, verified-custom 1FTSO r = 0.396, verified-custom Burst r = -0.432.
  latticeCellsJson Json?
  latticeCellsN    Int   @default(0)

  // USDC CONFIG SIGNATURE. The example provider's shipped feeds.json sources USDC/USD from five
  // USDC/USDT order books, then multiplies by the provider's OWN USDT/USD median
  // (ccxt-provider-service.ts, price * usdtToUsd). USDC/USDT books tick at 1e-4, so for anyone using
  // that config the ratio USDC_USD / USDT_USD must land on a 1e-4 grid. A provider quoting USDC from
  // native USD books has no such constraint.
  //
  // This needs NOTHING but the provider's own two submitted values: no reference instance, no field
  // baseline, no calibration. Measured across three windows including one 12 days earlier:
  //   our reference instances 0.504-1.000 | candidate cluster 0.536-1.000
  //   1FTSO 0.095-0.152 | Burst FTSO identical | field bulk 0.055-0.245
  // Both verified-custom controls read custom in 3 of 3 windows; all candidates read example-like in
  // 51 of 51 classifications.
  usdcGridHits Int   @default(0)
  usdcGridN    Int   @default(0)
  // Pearson sums over (USDC_USD, USDT_USD) so the API can gate on their correlation. A USDC derived
  // from USDT inherits USDT's variation; without this gate a provider running example code with a
  // different USDC book (Digital Dynamix, measured) reads as a false custom.
  usdcSumX     Float @default(0)
  usdcSumY     Float @default(0)
  usdcSumXY    Float @default(0)
  usdcSumXX    Float @default(0)
  usdcSumYY    Float @default(0)

  updatedAt DateTime @updatedAt

  @@unique([network, voter])
  @@index([voter])
}

// Price TICK for each (feed, exchange, symbol) the example provider's default feeds.json reads, pulled
// from ccxt market metadata. Denormalized by feed so the scorer can build each feed's candidate lattices
// without needing feeds.json (which lives in the reference checkout, not the registry repo). The raw tick
// is stored rather than the derived T, because T = tick * 10^decimals and `decimals` changes per reward
// epoch - the scorer applies its own canonical decimals.
// A third party's PUBLISHED detection verdict for a provider, cached for cross-reference.
//
// Not our measurement and never presented as such. Their method shares no signals with ours (they
// compare cadence and value fingerprints against their own reference; we use tick-grid lattices and a
// config signature), which is exactly what makes agreement informative and disagreement worth a look.
// Admin-only: this is never published or exposed on any public surface.
model ExternalDetection {
  id              String    @id @default(cuid())
  source          String // e.g. "cerberusonchain"
  // Their provider label, and a normalised form for joining to our names.
  name            String
  nameKey         String
  probability     Float?
  verdict         String?
  // Identity address, where we can resolve one. Their anonymised "Provider_NNN" labels turn out to be
  // Flare systems-explorer ENTITY IDS, so those resolve exactly; named records resolve by display_name.
  // Joining on address rather than name is what lets unlisted providers be cross-referenced at all, and
  // it also closed a gap where the name join silently missed a verified control they publish anonymously.
  identityAddress String?
  // When THEIR analysis was generated, distinct from when we fetched it. A stale third-party snapshot
  // presented as current would be worse than no cross-reference at all.
  snapshotAt      DateTime?
  fetchedAt       DateTime  @updatedAt

  @@unique([source, nameKey])
  @@index([source])
  @@index([identityAddress])
}

model FeedSourceTick {
  id       String @id @default(cuid())
  feedName String // canonical feed name, e.g. "BTC/USD"
  exchange String
  symbol   String
  tick     Float

  updatedAt DateTime @updatedAt

  @@unique([feedName, exchange, symbol])
  @@index([feedName])
}

// Singleton running calibration state for the example-provider probability (Flare). Holds the two
// distributions the probability is computed against, each as EW mean/var:
//   - anchor*: the similarity score our OWN reference instances receive when scored as if they were
//     providers (distance to the OTHER reference vs the field). This is the "known example provider"
//     positive anchor - the only trusted label, since we control these instances.
//   - field*: the similarity score of the whole provider field (mostly custom) - the negative baseline.
// A provider's probability is the posterior that its similarity was drawn from the anchor distribution
// rather than the field distribution (equal priors), so it is calibrated to real, measured spreads
// rather than arbitrary constants.
model DetectionCalibration {
  id         String   @id @default("flare")
  anchorMean Float    @default(0)
  anchorVar  Float    @default(0.01)
  anchorN    Int      @default(0)
  fieldMean  Float    @default(0)
  fieldVar   Float    @default(0.01)
  fieldN     Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Admin-only display-name overrides for the Detection surfaces (Flare example-provider report). Some
// entities submit on-chain but have no registry listing, so they show as "(unlisted)"; an operator can
// pin a human label (e.g. a known test entity they run) keyed by the submit address (the address stored
// in ProviderSimilarity.voter). Detection-only - never affects the public registry/feed.
model DetectionLabel {
  address     String   @id // lowercased submit address
  label       String?
  // VERIFIED-custom flag: an operator has confirmed this provider does NOT run the example provider (e.g.
  // our own FTSO, or a team whose custom infra we've verified). Used as a TRUSTED NEGATIVE in calibration
  // - fed into the field distribution as a confirmed non-example-provider, sharpening the anchor-vs-field
  // boundary. Only set on providers verified out-of-band; never a guess.
  knownCustom Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// Cursor: the last voting round the scorer has processed, so each run picks up every NEW settled round
// since then (not just a fixed last-3 window that fell behind wall-clock). Single row id="flare".
model DetectionCursor {
  id                  String   @id
  lastRound           Int      @default(0)
  // DB-cached canonical feed order [{name,decimals}] + the round range it covers, so the scorer does not
  // hit GitHub's rate-limited contents API every 5-min run. Refreshed only when the round leaves the
  // cached range (i.e. per reward epoch, ~3.5 days).
  canonicalJson       Json?
  canonicalFrom       Int?
  canonicalTo         Int?
  // Our REFERENCE's error profile: EW mean of ln(|deviation from field median|) per feed, same shape as
  // ProviderSimilarity.feedErrorsJson, so the two can be de-meaned and correlated.
  refFeedErrorsJson   Json?
  // Per-cell tick-grid hit profiles for OUR reference instances, keyed by instance id then cell:
  //   { "full:1": { "BTC/USD|10": summedExcess, ... }, "top3:1": {...} }
  // This is the positive class the per-cell pattern match is scored against. Unlike the error-profile
  // fingerprint it compares DISCRETE venue-grid hit patterns rather than value distances, and it has
  // validated controls at both ends (1FTSO 0.396, Burst FTSO -0.432).
  refLatticeCellsJson Json?
  refLatticeCellsN    Int      @default(0)
  updatedAt           DateTime @updatedAt
}

// PAIRWISE BYTE-EXACT SUBMISSION AGREEMENT between two providers, over a rolling window of rounds.
//
// This is the measurement FIP.02's collusion clause actually asks about: whether providers show "a
// strong statistical correlation in their submissions". Unlike everything in ProviderSimilarity it
// involves NO inference about which software anyone runs. It reads reveals off the chain and counts
// cells where two providers' encoded values are identical to the last digit. No reference instance, no
// calibration, no threshold in the measurement itself.
//
// That distinction is why this table exists separately: the classification is inference and stays
// private, this is direct measurement and is publishable. Do not merge them.
//
// Stored as counts rather than a rate so windows can be re-derived and so a partial run cannot silently
// produce a confident-looking ratio from three cells. addrA/addrB are ordered lexically so a pair has
// exactly one row regardless of which side is seen first.
model SubmissionAgreement {
  id      String @id @default(cuid())
  network String

  addrA String // lexically smaller submit address
  addrB String

  agreeCells Int // cells where both priced the feed AND the encoded uint32 matched exactly
  totalCells Int // cells where both priced the feed at all

  fromRound Int
  toRound   Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([network, addrA, addrB])
  @@index([network, toRound])
  @@index([network, addrA])
  @@index([network, addrB])
}

// Per-provider rollup of the above, one row per provider per measurement run, kept as HISTORY so the
// product can show whether correlation is falling (which is what the governance proposal's review
// clause turns on). The per-pair table is overwritten each run; this is not.
//
// 98 providers x 4 runs a day is a few hundred rows a day, which is sustainable. Storing per-PAIR
// history would be ~19k rows a day and is deliberately not done.
model CorrelationSnapshot {
  id      String @id @default(cuid())
  network String
  voter   String // submit address

  maxRate    Float // highest agreement with any single peer
  meanRate   Float // mean across all comparable peers
  // Peers above the operational threshold. The count, not the identities: who a provider correlates
  // with is derivable from SubmissionAgreement for anyone entitled to see it, and does not belong in a
  // rollup that feeds public surfaces.
  peersAbove Int
  peers      Int // comparable peers in this window

  fromRound Int
  toRound   Int

  createdAt DateTime @default(now())

  @@index([network, voter, createdAt])
  @@index([network, createdAt])
}
